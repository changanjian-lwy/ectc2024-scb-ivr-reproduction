* R04E12 - phase-1 precharge admission gate (r04e12_npre_10)
* SENSITIVITY CASE: N_PRECHARGE=10. Fixed for the whole grid
* (BOUNDARY.md Section 4, R04E10's own best-performing cell):
* I_LIMIT=60 A, T_CHARGE_MAX=5.000000e-08 s, T_FREEWHEEL_MAX=
* 5.000000e-08 s.
* PARENT: R04E10 (r04e10_ilimit_60a_tchg_50ns.cir), itself parented on
* R04E9. SINGLE CONCEPTUAL CHANGE from R04E10: a precharge admission gate
* is inserted before the machine's normal round-robin rotation. See
* scripts/build_r04e12_cases.py module docstring for the exact
* compile-time-unrolled construct used (N_PRECHARGE-1 extra state pairs
* electrically mirroring CHARGE1/FREE1, chained before the real CHARGE1)
* and its equivalence to BOUNDARY.md Section 2's counter-gate description.
* N_PRECHARGE=1 emits ZERO extra state pairs -- this cell's machine block
* is mechanism-identical to R04E10's own committed
* I_LIMIT=60A/T_CHARGE_MAX=50ns cell (verified in RESULTS.md).
* Everything else (node topology, CFLY=3uF, COUT=4.672mF, GS61008T device
* data, true-zero-energy initial conditions, current-limit/timeout exit
* rules, handoff-condition monitor) is unchanged from R04E10.
* SCOPE: bootstrap-only. Does NOT build or test handoff into the existing
* strict steady-state controller; only measures whether/when the handoff
* CONDITION is reached.
* This machine has 26 states (9
* extra precharge pairs + 8 original R04E10 states); initial state is
* PCHG1_1 (code 0).

.include "../../../../paper_locked/04_component_models/GS61008T_typical_params.lib"
.param VIN=48 VOUT_REF=1 POUT_MODULE=250 NP=4 NM=4
.param LPHASE=1.466666667e-09 CFLY=3.000000e-06
.param COUT={8*220u+32*47u+64*22u} RLOAD={VOUT_REF*VOUT_REF/POUT_MODULE}
.param CH={GS61008T_COTR_0_50V} CL={2*GS61008T_COTR_0_50V}
.param RHS={GS61008T_RDS_TYP_25C} RLS={GS61008T_RDS_TYP_25C/2}
.param RLDAMP=1u VGATE=5

.param I_LIMIT=60
.param T_FREEWHEEL_MAX=5.000000e-08
.param T_CHARGE_MAX=5.000000e-08
* Elapsed-time timer components (NUMERICAL_IDEALIZATION, no physical
* counterpart), same TIMER_C/TIMER_RESET_RON values R04E5/R04E9 used.
.param TIMER_C=1p TIMER_RESET_RON=5

* Handoff-condition monitor (measurement only -- this experiment does NOT
* build or exercise the actual handoff/steady-state chain, per BOUNDARY.md).
.param VOUT_LO=0.950000 VOUT_HI=1.050000
.param VC1_LO=35.280000 VC1_HI=36.720000
.param VC2_LO=23.520000 VC2_HI=24.480000
.param VC3_LO=11.760000 VC3_HI=12.240000

VRAIL vin 0 {VIN}
CCO out 0 {COUT} ic=0
RLOAD_MAIN out 0 {RLOAD}
XMOD vin out 0 gh1_cmd gl1_cmd gh2_cmd gl2_cmd gh3_cmd gl3_cmd gh4_cmd gl4_cmd SCB4P_P24_R04E12

BVC1 vc1_mon 0 V=V(xmod:a1,xmod:x1)
BVC2 vc2_mon 0 V=V(xmod:a2,xmod:x2)
BVC3 vc3_mon 0 V=V(xmod:a3,xmod:x3)
RVC1 vc1_mon 0 1k
RVC2 vc2_mon 0 1k
RVC3 vc3_mon 0 1k


CTIMER timer 0 {TIMER_C} ic=0
BTIMER_CHG timer 0 I=-1p*((V(state_mon)>0.5)&(V(state_mon)<1.5)|(V(state_mon)>2.5)&(V(state_mon)<3.5)|(V(state_mon)>4.5)&(V(state_mon)<5.5)|(V(state_mon)>6.5)&(V(state_mon)<7.5)|(V(state_mon)>8.5)&(V(state_mon)<9.5)|(V(state_mon)>10.5)&(V(state_mon)<11.5)|(V(state_mon)>12.5)&(V(state_mon)<13.5)|(V(state_mon)>14.5)&(V(state_mon)<15.5)|(V(state_mon)>16.5)&(V(state_mon)<17.5)|(V(state_mon)>18.5)&(V(state_mon)<19.5)|(V(state_mon)>20.5)&(V(state_mon)<21.5)|(V(state_mon)>22.5)&(V(state_mon)<23.5)|(V(state_mon)>24.5)&(V(state_mon)<25.5))
BRESET_GATE reset_gate 0 V=5*((V(state_mon)<0.5)|(V(state_mon)>1.5)&(V(state_mon)<2.5)|(V(state_mon)>3.5)&(V(state_mon)<4.5)|(V(state_mon)>5.5)&(V(state_mon)<6.5)|(V(state_mon)>7.5)&(V(state_mon)<8.5)|(V(state_mon)>9.5)&(V(state_mon)<10.5)|(V(state_mon)>11.5)&(V(state_mon)<12.5)|(V(state_mon)>13.5)&(V(state_mon)<14.5)|(V(state_mon)>15.5)&(V(state_mon)<16.5)|(V(state_mon)>17.5)&(V(state_mon)<18.5)|(V(state_mon)>19.5)&(V(state_mon)<20.5)|(V(state_mon)>21.5)&(V(state_mon)<22.5)|(V(state_mon)>23.5)&(V(state_mon)<24.5))
SRESET timer 0 reset_gate 0 SWRESET
.model SWRESET SW(Ron={TIMER_RESET_RON} Roff=1Meg Vt=2.5 Vh=0)
CTIMER_CHG timer_chg 0 {TIMER_C} ic=0
BTIMER_CHG2 timer_chg 0 I=-1p*((V(state_mon)<0.5)|(V(state_mon)>1.5)&(V(state_mon)<2.5)|(V(state_mon)>3.5)&(V(state_mon)<4.5)|(V(state_mon)>5.5)&(V(state_mon)<6.5)|(V(state_mon)>7.5)&(V(state_mon)<8.5)|(V(state_mon)>9.5)&(V(state_mon)<10.5)|(V(state_mon)>11.5)&(V(state_mon)<12.5)|(V(state_mon)>13.5)&(V(state_mon)<14.5)|(V(state_mon)>15.5)&(V(state_mon)<16.5)|(V(state_mon)>17.5)&(V(state_mon)<18.5)|(V(state_mon)>19.5)&(V(state_mon)<20.5)|(V(state_mon)>21.5)&(V(state_mon)<22.5)|(V(state_mon)>23.5)&(V(state_mon)<24.5))
BRESET_GATE2 reset_gate_chg 0 V=5*((V(state_mon)>0.5)&(V(state_mon)<1.5)|(V(state_mon)>2.5)&(V(state_mon)<3.5)|(V(state_mon)>4.5)&(V(state_mon)<5.5)|(V(state_mon)>6.5)&(V(state_mon)<7.5)|(V(state_mon)>8.5)&(V(state_mon)<9.5)|(V(state_mon)>10.5)&(V(state_mon)<11.5)|(V(state_mon)>12.5)&(V(state_mon)<13.5)|(V(state_mon)>14.5)&(V(state_mon)<15.5)|(V(state_mon)>16.5)&(V(state_mon)<17.5)|(V(state_mon)>18.5)&(V(state_mon)<19.5)|(V(state_mon)>20.5)&(V(state_mon)<21.5)|(V(state_mon)>22.5)&(V(state_mon)<23.5)|(V(state_mon)>24.5)&(V(state_mon)<25.5))
SRESET_CHG timer_chg 0 reset_gate_chg 0 SWRESET

* Handoff-condition observer: high only while Vout and all three flying
* capacitor voltages simultaneously sit within their declared bands.
BHANDOFF handoff_flag 0 V=5*((V(out)>=VOUT_LO)&(V(out)<=VOUT_HI)&(V(vc1_mon)>=VC1_LO)&(V(vc1_mon)<=VC1_HI)&(V(vc2_mon)>=VC2_LO)&(V(vc2_mon)<=VC2_HI)&(V(vc3_mon)>=VC3_LO)&(V(vc3_mon)<=VC3_HI))
RHANDOFF handoff_flag 0 1k

* Unified event-driven, latched precharge-then-round-robin machine.
* See scripts/build_r04e12_cases.py for the exact construct.
.machine 1p
.state PCHG1_1 0
.state PFREE1_1 1
.state PCHG1_2 2
.state PFREE1_2 3
.state PCHG1_3 4
.state PFREE1_3 5
.state PCHG1_4 6
.state PFREE1_4 7
.state PCHG1_5 8
.state PFREE1_5 9
.state PCHG1_6 10
.state PFREE1_6 11
.state PCHG1_7 12
.state PFREE1_7 13
.state PCHG1_8 14
.state PFREE1_8 15
.state PCHG1_9 16
.state PFREE1_9 17
.state CHARGE1 18
.state FREE1 19
.state CHARGE2 20
.state FREE2 21
.state CHARGE3 22
.state FREE3 23
.state CHARGE4 24
.state FREE4 25
.rule PCHG1_1 PFREE1_1 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PCHG1_2 PFREE1_2 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PFREE1_1 PCHG1_2 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule PCHG1_3 PFREE1_3 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PFREE1_2 PCHG1_3 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule PCHG1_4 PFREE1_4 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PFREE1_3 PCHG1_4 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule PCHG1_5 PFREE1_5 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PFREE1_4 PCHG1_5 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule PCHG1_6 PFREE1_6 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PFREE1_5 PCHG1_6 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule PCHG1_7 PFREE1_7 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PFREE1_6 PCHG1_7 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule PCHG1_8 PFREE1_8 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PFREE1_7 PCHG1_8 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule PCHG1_9 PFREE1_9 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule PFREE1_8 PCHG1_9 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule PFREE1_9 CHARGE1 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule CHARGE1 FREE1 (I(XMOD:L1)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule FREE1 CHARGE2 (I(XMOD:L1)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule CHARGE2 FREE2 (I(XMOD:L2)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule FREE2 CHARGE3 (I(XMOD:L2)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule CHARGE3 FREE3 (I(XMOD:L3)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule FREE3 CHARGE4 (I(XMOD:L3)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.rule CHARGE4 FREE4 (I(XMOD:L4)>=I_LIMIT) | (V(timer_chg)>=T_CHARGE_MAX)
.rule FREE4 CHARGE1 (I(XMOD:L4)<=0) | (V(timer)>=T_FREEWHEEL_MAX)
.output (gh1_cmd) VGATE*((state==PCHG1_1) | (state==PCHG1_2) | (state==PCHG1_3) | (state==PCHG1_4) | (state==PCHG1_5) | (state==PCHG1_6) | (state==PCHG1_7) | (state==PCHG1_8) | (state==PCHG1_9) | (state==CHARGE1))
.output (gl1_cmd) VGATE*((state==PFREE1_1) | (state==PFREE1_2) | (state==PFREE1_3) | (state==PFREE1_4) | (state==PFREE1_5) | (state==PFREE1_6) | (state==PFREE1_7) | (state==PFREE1_8) | (state==PFREE1_9) | (state==FREE1))
.output (gh2_cmd) VGATE*(state==CHARGE2)
.output (gl2_cmd) VGATE*(state==FREE2)
.output (gh3_cmd) VGATE*(state==CHARGE3)
.output (gl3_cmd) VGATE*(state==FREE3)
.output (gh4_cmd) VGATE*(state==CHARGE4)
.output (gl4_cmd) VGATE*(state==FREE4)
.output (state_mon) state
.output (rot_flag) VGATE*(state==FREE4)
.endmachine

RSTATE state_mon 0 1k
RROT rot_flag 0 1k
RGH1 gh1_cmd 0 1k
RGL1 gl1_cmd 0 1k
RGH2 gh2_cmd 0 1k
RGL2 gl2_cmd 0 1k
RGH3 gh3_cmd 0 1k
RGL3 gl3_cmd 0 1k
RGH4 gh4_cmd 0 1k
RGL4 gl4_cmd 0 1k

.meas tran STATE_FINAL FIND V(state_mon) AT 2.000000e-05
.meas tran VOUT_FINAL FIND V(out) AT 2.000000e-05
.meas tran VC1_FINAL FIND V(vc1_mon) AT 2.000000e-05
.meas tran VC2_FINAL FIND V(vc2_mon) AT 2.000000e-05
.meas tran VC3_FINAL FIND V(vc3_mon) AT 2.000000e-05
.meas tran T_HANDOFF WHEN V(handoff_flag)=2.5 RISE=1
.meas tran VOUT_AT_20PCT FIND V(out) AT 4.000000e-06
.meas tran VC1_AT_20PCT FIND V(vc1_mon) AT 4.000000e-06
.meas tran VC2_AT_20PCT FIND V(vc2_mon) AT 4.000000e-06
.meas tran VC3_AT_20PCT FIND V(vc3_mon) AT 4.000000e-06
.meas tran STATE_AT_20PCT FIND V(state_mon) AT 4.000000e-06
.meas tran VOUT_AT_40PCT FIND V(out) AT 8.000000e-06
.meas tran VC1_AT_40PCT FIND V(vc1_mon) AT 8.000000e-06
.meas tran VC2_AT_40PCT FIND V(vc2_mon) AT 8.000000e-06
.meas tran VC3_AT_40PCT FIND V(vc3_mon) AT 8.000000e-06
.meas tran STATE_AT_40PCT FIND V(state_mon) AT 8.000000e-06
.meas tran VOUT_AT_60PCT FIND V(out) AT 1.200000e-05
.meas tran VC1_AT_60PCT FIND V(vc1_mon) AT 1.200000e-05
.meas tran VC2_AT_60PCT FIND V(vc2_mon) AT 1.200000e-05
.meas tran VC3_AT_60PCT FIND V(vc3_mon) AT 1.200000e-05
.meas tran STATE_AT_60PCT FIND V(state_mon) AT 1.200000e-05
.meas tran VOUT_AT_80PCT FIND V(out) AT 1.600000e-05
.meas tran VC1_AT_80PCT FIND V(vc1_mon) AT 1.600000e-05
.meas tran VC2_AT_80PCT FIND V(vc2_mon) AT 1.600000e-05
.meas tran VC3_AT_80PCT FIND V(vc3_mon) AT 1.600000e-05
.meas tran STATE_AT_80PCT FIND V(state_mon) AT 1.600000e-05
.meas tran VOUT_AT_100PCT FIND V(out) AT 2.000000e-05
.meas tran VC1_AT_100PCT FIND V(vc1_mon) AT 2.000000e-05
.meas tran VC2_AT_100PCT FIND V(vc2_mon) AT 2.000000e-05
.meas tran VC3_AT_100PCT FIND V(vc3_mon) AT 2.000000e-05
.meas tran STATE_AT_100PCT FIND V(state_mon) AT 2.000000e-05
.meas tran IL1_MAX MAX I(XMOD:L1)
.meas tran IL1_MIN MIN I(XMOD:L1)
.meas tran IL2_MAX MAX I(XMOD:L2)
.meas tran IL2_MIN MIN I(XMOD:L2)
.meas tran IL3_MAX MAX I(XMOD:L3)
.meas tran IL3_MIN MIN I(XMOD:L3)
.meas tran IL4_MAX MAX I(XMOD:L4)
.meas tran IL4_MIN MIN I(XMOD:L4)
* NOTE: ICS1-3 windowed FROM 2n, not 0, excluding the same sub-2ns t=0
* ideal-switch/capacitor initial-condition numerical startup spike R04E6/
* R04E8/R04E9 already documented and excluded.
.meas tran ICS1_MAX MAX I(XMOD:CS1) FROM 2n TO 2.000000e-05
.meas tran ICS1_MIN MIN I(XMOD:CS1) FROM 2n TO 2.000000e-05
.meas tran ICS2_MAX MAX I(XMOD:CS2) FROM 2n TO 2.000000e-05
.meas tran ICS2_MIN MIN I(XMOD:CS2) FROM 2n TO 2.000000e-05
.meas tran ICS3_MAX MAX I(XMOD:CS3) FROM 2n TO 2.000000e-05
.meas tran ICS3_MIN MIN I(XMOD:CS3) FROM 2n TO 2.000000e-05
.meas tran T_ROT1 WHEN V(rot_flag)=2.5 FALL=1
.meas tran VOUT_ROT1 FIND V(out) WHEN V(rot_flag)=2.5 FALL=1
.meas tran VC1_ROT1 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=1
.meas tran VC2_ROT1 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=1
.meas tran VC3_ROT1 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=1
.meas tran T_ROT2 WHEN V(rot_flag)=2.5 FALL=2
.meas tran VOUT_ROT2 FIND V(out) WHEN V(rot_flag)=2.5 FALL=2
.meas tran VC1_ROT2 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=2
.meas tran VC2_ROT2 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=2
.meas tran VC3_ROT2 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=2
.meas tran T_ROT3 WHEN V(rot_flag)=2.5 FALL=3
.meas tran VOUT_ROT3 FIND V(out) WHEN V(rot_flag)=2.5 FALL=3
.meas tran VC1_ROT3 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=3
.meas tran VC2_ROT3 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=3
.meas tran VC3_ROT3 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=3
.meas tran T_ROT4 WHEN V(rot_flag)=2.5 FALL=4
.meas tran VOUT_ROT4 FIND V(out) WHEN V(rot_flag)=2.5 FALL=4
.meas tran VC1_ROT4 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=4
.meas tran VC2_ROT4 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=4
.meas tran VC3_ROT4 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=4
.meas tran T_ROT5 WHEN V(rot_flag)=2.5 FALL=5
.meas tran VOUT_ROT5 FIND V(out) WHEN V(rot_flag)=2.5 FALL=5
.meas tran VC1_ROT5 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=5
.meas tran VC2_ROT5 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=5
.meas tran VC3_ROT5 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=5
.meas tran T_ROT6 WHEN V(rot_flag)=2.5 FALL=6
.meas tran VOUT_ROT6 FIND V(out) WHEN V(rot_flag)=2.5 FALL=6
.meas tran VC1_ROT6 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=6
.meas tran VC2_ROT6 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=6
.meas tran VC3_ROT6 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=6
.meas tran T_ROT7 WHEN V(rot_flag)=2.5 FALL=7
.meas tran VOUT_ROT7 FIND V(out) WHEN V(rot_flag)=2.5 FALL=7
.meas tran VC1_ROT7 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=7
.meas tran VC2_ROT7 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=7
.meas tran VC3_ROT7 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=7
.meas tran T_ROT8 WHEN V(rot_flag)=2.5 FALL=8
.meas tran VOUT_ROT8 FIND V(out) WHEN V(rot_flag)=2.5 FALL=8
.meas tran VC1_ROT8 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=8
.meas tran VC2_ROT8 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=8
.meas tran VC3_ROT8 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=8
.meas tran T_ROT9 WHEN V(rot_flag)=2.5 FALL=9
.meas tran VOUT_ROT9 FIND V(out) WHEN V(rot_flag)=2.5 FALL=9
.meas tran VC1_ROT9 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=9
.meas tran VC2_ROT9 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=9
.meas tran VC3_ROT9 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=9
.meas tran T_ROT10 WHEN V(rot_flag)=2.5 FALL=10
.meas tran VOUT_ROT10 FIND V(out) WHEN V(rot_flag)=2.5 FALL=10
.meas tran VC1_ROT10 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=10
.meas tran VC2_ROT10 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=10
.meas tran VC3_ROT10 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=10
.meas tran T_ROT11 WHEN V(rot_flag)=2.5 FALL=11
.meas tran VOUT_ROT11 FIND V(out) WHEN V(rot_flag)=2.5 FALL=11
.meas tran VC1_ROT11 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=11
.meas tran VC2_ROT11 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=11
.meas tran VC3_ROT11 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=11
.meas tran T_ROT12 WHEN V(rot_flag)=2.5 FALL=12
.meas tran VOUT_ROT12 FIND V(out) WHEN V(rot_flag)=2.5 FALL=12
.meas tran VC1_ROT12 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=12
.meas tran VC2_ROT12 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=12
.meas tran VC3_ROT12 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=12
.meas tran T_ROT13 WHEN V(rot_flag)=2.5 FALL=13
.meas tran VOUT_ROT13 FIND V(out) WHEN V(rot_flag)=2.5 FALL=13
.meas tran VC1_ROT13 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=13
.meas tran VC2_ROT13 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=13
.meas tran VC3_ROT13 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=13
.meas tran T_ROT14 WHEN V(rot_flag)=2.5 FALL=14
.meas tran VOUT_ROT14 FIND V(out) WHEN V(rot_flag)=2.5 FALL=14
.meas tran VC1_ROT14 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=14
.meas tran VC2_ROT14 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=14
.meas tran VC3_ROT14 FIND V(vc3_mon) WHEN V(rot_flag)=2.5 FALL=14
.meas tran T_ROT15 WHEN V(rot_flag)=2.5 FALL=15
.meas tran VOUT_ROT15 FIND V(out) WHEN V(rot_flag)=2.5 FALL=15
.meas tran VC1_ROT15 FIND V(vc1_mon) WHEN V(rot_flag)=2.5 FALL=15
.meas tran VC2_ROT15 FIND V(vc2_mon) WHEN V(rot_flag)=2.5 FALL=15
